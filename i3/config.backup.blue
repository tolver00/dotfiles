# i3 config - ported from herbstluftwm
# ──────────────────────────────────────────────

set $mod Mod4

# ──────────────────────────────────────────────
# Autostart
# ──────────────────────────────────────────────
exec --no-startup-id ~/.fehbg
exec --no-startup-id picom --config ~/.config/picom/picom.conf -b

# ──────────────────────────────────────────────
# Terminal & launcher
# ──────────────────────────────────────────────
bindsym $mod+Return exec alacritty
bindsym Mod1+r exec dmenu_run -l 5 -fn "IBM Plex Mono-8" -nb "#203033" -sb "#1A2B2E" -sf "#C2D6Da"

# ──────────────────────────────────────────────
# WM control
# ──────────────────────────────────────────────
bindsym $mod+Control+r reload
bindsym $mod+Shift+q kill

# ──────────────────────────────────────────────
# Focus
# ──────────────────────────────────────────────
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# ──────────────────────────────────────────────
# Move clients
# ──────────────────────────────────────────────
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# ──────────────────────────────────────────────
# Resizing
# ──────────────────────────────────────────────
mode "resize" {
    bindsym h resize shrink width 5 px or 5 ppt
    bindsym j resize grow height 5 px or 5 ppt
    bindsym k resize shrink height 5 px or 5 ppt
    bindsym l resize grow width 5 px or 5 ppt

    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# ──────────────────────────────────────────────
# Splitting
# ──────────────────────────────────────────────
bindsym $mod+u split v
bindsym $mod+o split h

# ──────────────────────────────────────────────
# Layout
# ──────────────────────────────────────────────
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+space floating toggle
bindsym $mod+space layout toggle split tabbed stacked

# Cycle focus
bindsym $mod+Tab focus next
bindsym $mod+Shift+Tab focus prev

# ──────────────────────────────────────────────
# Focus monitor
# ──────────────────────────────────────────────
bindsym $mod+period focus output right
bindsym $mod+comma focus output left
bindsym $mod+Shift+period move container to output right
bindsym $mod+Shift+comma move container to output left

# ──────────────────────────────────────────────
# Brightness
# ──────────────────────────────────────────────
bindsym $mod+F5 exec brightnessctl s 10%-
bindsym $mod+F6 exec brightnessctl s +10%

# ──────────────────────────────────────────────
# Volume
# ──────────────────────────────────────────────
bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle

# ──────────────────────────────────────────────
# Screenshot
# ──────────────────────────────────────────────
bindsym $mod+Shift+s exec scrot -s /home/at/Pictures/screenshots/screenshot_%Y-%m-%d_%H-%M-%S.png

# ──────────────────────────────────────────────
# Mouse
# ──────────────────────────────────────────────
floating_modifier $mod

# ──────────────────────────────────────────────
# Workspaces pinned to monitors
# ──────────────────────────────────────────────
# Replace DP-1 / HDMI-1 with your actual xrandr output names
workspace 1 output DP-1
workspace 2 output DP-1
workspace 3 output DP-1
workspace 4 output DP-1
workspace 5 output HDMI-A-0
workspace 6 output HDMI-A-0
workspace 7 output HDMI-A-0
workspace 8 output HDMI-A-0
workspace 9 output HDMI-A-0

bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4
bindsym $mod+5 workspace 5
bindsym $mod+6 workspace 6
bindsym $mod+7 workspace 7
bindsym $mod+8 workspace 8
bindsym $mod+9 workspace 9

bindsym $mod+Shift+1 move container to workspace 1
bindsym $mod+Shift+2 move container to workspace 2
bindsym $mod+Shift+3 move container to workspace 3
bindsym $mod+Shift+4 move container to workspace 4
bindsym $mod+Shift+5 move container to workspace 5
bindsym $mod+Shift+6 move container to workspace 6
bindsym $mod+Shift+7 move container to workspace 7
bindsym $mod+Shift+8 move container to workspace 8
bindsym $mod+Shift+9 move container to workspace 9

# ──────────────────────────────────────────────
# Theme / appearance
# ──────────────────────────────────────────────
# class                 border  backgr  text    indicator child_border
client.focused          #A8C8CE #A8C8CE #162122 #A8C8CE   #A8C8CE
client.unfocused        #2C444E #2C444E #C2D6DA #2C444E   #2C444E
client.focused_inactive #2C444E #2C444E #C2D6DA #2C444E   #2C444E
client.urgent           #A06060 #A06060 #162122 #A06060   #A06060

default_border pixel 1
default_floating_border pixel 1
gaps inner 0
gaps outer 0

focus_follows_mouse yes

# ──────────────────────────────────────────────
# Window rules
# ──────────────────────────────────────────────
for_window [class="mpv"] floating enable


# ──────────────────────────────────────────────
# Panel
# ──────────────────────────────────────────────
bar {
    status_command i3status
    position top
    colors {
        background #162122
        statusline #C2D6DA
        separator  #2C444E

        focused_workspace  #A8C8CE #A8C8CE #162122
        active_workspace   #2C444E #2C444E #C2D6DA
        inactive_workspace #162122 #162122 #C2D6DA
        urgent_workspace   #A06060 #A06060 #162122
    }
    font pango:IBM Plex Mono 8
}


