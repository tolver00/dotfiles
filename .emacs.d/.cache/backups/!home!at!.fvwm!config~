ImagePath $HOME/.fvwm/icons:+
DefaultFont "xft:Marcellus:size=9:antialias=true"

DesktopConfiguration per-monitor

# Set occupied working area on both monitors
EwmhBaseStruts screen HDMI-A-0 0 0 25 0
EwmhBaseStruts screen DisplayPort-1 0 0 25 0
# Uncomment to hide geometry window for move action
#HideGeometryWindow Move
# == Set cursors ==
# Classic "X" root cursor
CursorStyle "ROOT" "left_ptr"

# exec feh to reload wallpaper
Exec sh ~/.fehbg

# == Pager/Desktops ==
# 2 x 2 desktops
DeskTopSize 5 1 
# Allow moving windows between desktops, but with a bit of resistance.
EdgeResistance 150 150
# Never scroll to next desktop using mouse.
EdgeScroll 0 0
# Pager Look.
# == Window colors and styles ==
# Menu colors are set in menu style below.
# Standard Color set for window decorations
# 3: Colorsets
#
#   0 - Default
#   1 - Inactive Windows
#   2 - Active Window
#   3 - Inactive Windows Borders
#   4 - Active Windows Borders
#   5 - Menu - Inactive Item
#   6 - Menu - Active Item
#   7 - Menu - Grayed Item
#   8 - Menu - Title
#  10+ Modules
###########
CleanupColorsets

# inactive
ColorSet 2  fg #6E787B, bg #111A1C, hi #162122, sh #0A0F10
# active							    
ColorSet 3  fg #C6C7C1, bg #243437, hi #2E4449, sh #0A0F10
# subtle variant						    
ColorSet 4  fg #D0D2CD, bg #304537, hi #607984, sh #0A0F10
# Utility/dialogs						    
ColorSet 19 fg #D0D2CD, bg #253946, hi #516466, sh #0A0F10
					
# focus								    
ColorSet 17  fg #D0D2CD, bg #243437, hi #2E4449, sh ##0A0F10
# plain
ColorSet 18  fg #D0D2CD, bg #162122, hi #516466, sh #0A0F10

ColorSet 20 fg #D6D8D2, bg #3E1F22, hi #6B3438, sh #0E1213


